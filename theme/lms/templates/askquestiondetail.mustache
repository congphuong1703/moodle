<div class="container" style="margin-top: 5rem">
    <a href="#" onclick="window.history.back();" class="text-decoration-none text-muted" style="font-size: 16px">&larr;
        Hỏi bài</a>

    <!-- Question Card -->
    {{#discussions}}
        <div style="display: flex">
            <div class="card mt-3 p-4" style="flex:1">
                <h5 style="display: flex; gap:8px">
                    <div>
                        <img src="pix/avatar.svg" alt="avatar">
                    </div>
                    <div style="display: flex; flex-direction: column">
                        <strong>{{fullname}}</strong> <small class="text-muted">{{createdat}}</small>
                    </div>
                </h5>
                <p>{{content}}</p>
                <div class="border rounded p-3 bg-light">
                    <p><strong>{{questionname}}</strong></p>
                    <p class="text-muted">{{{questiontext}}}</p>
                    <!-- Options -->
                    <div class="question-options">
                        {{# is_shortanswer}}
                        {{/is_shortanswer}}
                        {{# is_multichoice }}
                            <div class="answer">
                                {{# options }}
                                    <div class="d-flex w-auto">
                                        <input type="radio" name="q{{ id }}" disabled="disabled" id="q{{ id }}"/>
                                        <div class="flex-fill ml-1">
                                            <p dir="ltr" style="text-align: left;">{{{value}}}</p>
                                        </div>
                                    </div>
                                {{/ options }}
                            </div>
                        {{/ is_multichoice }}
                        {{# is_truefalse }}
                            <div class="answer">
                                <div>
                                    <input type="radio" name="q0"
                                           id="q_0" disabled="disabled" value="1"/>
                                    <label for="q_0" class="ml-1">True</label></div>
                                <div class="r1">
                                    <input type="radio" name="q1" id="q_1" value="0" disabled="disabled"/>
                                    <label for="q_1" class="ml-1">False</label>
                                </div>
                            </div>
                        {{/ is_truefalse }}
                    </div>
                    {{#quizid}}
                        <a href="{{urlquiz}}"
                           style="text-decoration: underline; color:#8E8E8E; font-size: 12px">{{quizname}}</a>
                    {{/quizid}}
                </div>
            </div>
        </div>
    {{/discussions}}
    {{#comments}}
        <div style="display: flex">
            <div class="card mt-3 p-4" style="flex:1">
                <h5 style="display: flex; gap:8px;">
                    <div>
                        <img src="pix/avatar.svg" alt="avatar">
                    </div>
                    <div style="display: flex; flex-direction: column">
                        <div>
                            <strong>{{fullname}}</strong>
                            <span class="badge"
                                  style="background-color: #4AD7A4; color:white; border-radius: 10px">{{rolename}}</span>
                        </div>
                        <small class="text-muted">{{createdat}}</small>
                    </div>
                </h5>
                <p>{{content}}</p>
            </div>
        </div>
    {{/comments}}
    <div class="card mt-2">
        <form id="answerquestion" method="post" action="{{urlroot}}/theme/lms/answerquestion.php">
            <div class="card-body">
                <div style="display: flex">
                    <div>
                        <h5 style="display: flex; gap:8px;">
                            <div>
                                <img src="pix/avatar.svg" alt="avatar">
                            </div>
                            <div style="display: flex; flex-direction: column">
                                <div>
                                    <strong>{{currentuser}}</strong>
                                    <span class="badge"
                                          style="background-color: #4AD7A4; color:white; border-radius: 10px">{{currentrole}}</span>
                                </div>
                                <small class="text-muted">{{currentusercreated}}</small>
                            </div>
                        </h5>

                    </div>
                </div>
                <hr/>
                <input id="id" value="{{discussionid}}" name="id" hidden/>
                <input id="next" value="{{next}}" hidden name="next"/>
                <textarea id="content" class="form-control" name="content" placeholder="Nhập câu trả lời" rows="4"
                          style="width:100%"></textarea>
            </div>
            <div class="card-footer" style="text-align: right">
                <button type="submit" class="btn btn-primary">Gửi câu trả lời</button>
            </div>
        </form>
    </div>
</div>